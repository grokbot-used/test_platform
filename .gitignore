# Local environments
.venv/
node_modules/
frontend/node_modules/

# Built frontend is served from the image; rebuild with npm run build
frontend/dist/

# Case/report data is baked into the image. Some report HTML files are large
# and must stay out of git (GitHub file limit).
data/

# Prebuilt image tarballs are published as GitHub Release assets
*.tar
*.tar.gz

# Python / SQLite sidecars
**/__pycache__/
**/*.pyc
**/*.pyo
*.db-shm
*.db-wal
*.db-journal

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
